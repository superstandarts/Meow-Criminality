{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "endhub-key-service",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "KEY_DB",
      "database_name": "endhub-keys",
      "database_id": "0a561f7b-8ba6-41fa-869d-992dfc70f82d",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
